# labwc autostart

# Set 1080p@60Hz for Moonlight streaming
wlr-randr --output HDMI-A-1 --mode 1920x1080@60Hz 2>/dev/null

# Background
swaybg -c '#1a1b26' >/dev/null 2>&1 &

# Panel
waybar >/dev/null 2>&1 &

# Notifications
mako >/dev/null 2>&1 &

# Sunshine (Moonlight streaming) - delay to let labwc fully start
( sleep 3 ; sunshine >/dev/null 2>&1 ) &

